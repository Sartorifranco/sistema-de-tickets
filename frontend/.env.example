# Configuración para SERVIDOR (producción)
# Copiar a .env y ajustar según el entorno

# URL del backend - Producción: https sin puerto (proxy reverso). Desarrollo: http con puerto
# Producción: REACT_APP_BACKEND_URL=https://bacarsa.dyndns.org
# Desarrollo: REACT_APP_BACKEND_URL=http://192.168.0.9:5040
REACT_APP_BACKEND_URL=https://bacarsa.dyndns.org

# Puerto del servidor de desarrollo (solo para npm start local)
PORT=3020

# Firebase (opcional - para Monitoreo de Equipos HWAgente y Push Notifications)
# REACT_APP_FIREBASE_API_KEY=...
# REACT_APP_FIREBASE_PROJECT_ID=devbac-42d14

# VAPID key para FCM (Push Notifications). Obtener en Firebase Console > Cloud Messaging > Web Push certificates
# REACT_APP_FIREBASE_VAPID_KEY=

# Web Push nativas (debe coincidir con VAPID_PRIVATE_KEY del backend). Generar con: npx web-push generate-vapid-keys
# REACT_APP_VAPID_PUBLIC_KEY=
