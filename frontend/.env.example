# Configuración para SERVIDOR (producción)
# Copiar a .env y ajustar según el entorno

# URL del backend - usar dominio público para acceso externo
REACT_APP_BACKEND_URL=http://192.168.0.9:5040

# Puerto del servidor de desarrollo (solo para npm start local)
PORT=3020

# Firebase (opcional - para Monitoreo de Equipos HWAgente)
# REACT_APP_FIREBASE_API_KEY=...
# REACT_APP_FIREBASE_PROJECT_ID=devbac-42d14
