# ============================================================
# Configuración para SERVIDOR (producción)
# Copiar a .env y ajustar según el entorno
# Ver docs/CONFIGURACION_COMPLETA.md para guía detallada
# ============================================================

# --- BASE DE DATOS (obligatorio) ---
DB_HOST=192.168.0.9
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=ticket_system
DB_PORT=3316

# --- SEGURIDAD (obligatorio) ---
JWT_SECRET=generar_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1d
NODE_ENV=production

# --- PUERTO Y URLs (obligatorio) ---
PORT=5040
FRONTEND_URL=http://bacarsa.dyndns.org:8001
# Opcional: URL pública del backend para Magic Links. Si no se define, se usa localhost:PORT
# API_URL=http://bacarsa.dyndns.org:5040

# --- CORREO / SMTP (obligatorio para notificaciones) ---
# Gmail: use contraseña de aplicación (App Password), no la contraseña normal.
# Si EMAIL_PASS tiene espacios, póngalo entre comillas: EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=contraseña_aplicacion

# --- WEB PUSH (notificaciones nativas del SO) ---
# Generar con: npx web-push generate-vapid-keys
# La clave pública debe coincidir con REACT_APP_VAPID_PUBLIC_KEY en frontend/.env
VAPID_PRIVATE_KEY=

# --- FIREBASE (obligatorio para Módulo de Compras + Push) ---
# 1. Firebase Console → Configuración → Cuentas de servicio → Generar nueva clave
# 2. Descargar JSON, renombrar a firebase-service-account.json
# 3. Colocar en backend/firebase-service-account.json (no subir a Git)
FIREBASE_CREDENTIALS=./firebase-service-account.json
# Bucket de Storage (para facturas). Ver Firebase Console → Storage
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app

# --- WHATSAPP TWILIO (opcional) ---
# https://console.twilio.com. Sandbox: cada destinatario envía "join CODIGO" al número From
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_SANDBOX_JOIN_CODE=loss-unusual
