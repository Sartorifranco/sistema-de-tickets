# Configuración para SERVIDOR (producción)
# Copiar a .env y ajustar según el entorno

# Base de datos
DB_HOST=192.168.0.9
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=ticket_system
DB_PORT=3316

# Seguridad
JWT_SECRET=generar_un_secreto_largo
JWT_EXPIRES_IN=1d
NODE_ENV=production

# Puerto del backend (servidor: 5040)
PORT=5040

# CORS - URL del frontend
FRONTEND_URL=http://bacarsa.dyndns.org:8001
# URL pública del backend (para Magic Links de aprobación por email). Si no se define, se usa localhost:PORT.
# API_URL=http://bacarsa.dyndns.org:5042

# Firebase (Push + Módulo Compras + Storage para facturas)
# Ruta al JSON del Service Account (o JSON como string)
# Console → Configuración → Cuentas de servicio → Generar nueva clave
FIREBASE_CREDENTIALS=./firebase-service-account.json
# Bucket de Storage (para subir facturas). Si falla con 404, use: {project_id}.firebasestorage.app
# Ej: devbac-42d14.firebasestorage.app (debe coincidir con Firebase Console → Storage)
# FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app

# Correo (Gmail u otro SMTP)
# Gmail: use contraseña de aplicación (App Password), no la contraseña normal.
# Si EMAIL_PASS tiene espacios, póngalo entre comillas: EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=contraseña_aplicacion

# Firebase (Push) - ruta al JSON del Service Account
# FIREBASE_CREDENTIALS=./firebase-service-account.json

# WhatsApp (Twilio) - https://console.twilio.com
# Sandbox: enviar "join <codigo>" al número de Twilio para activar
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
# Número sandbox por defecto; para producción usar tu WhatsApp Business
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Código para unirse al sandbox (cada destinatario envía "join XXX" al número From)
TWILIO_WHATSAPP_SANDBOX_JOIN_CODE=loss-unusual
