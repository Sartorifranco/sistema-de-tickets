# Configuración E2E - Copiar a .env.e2e y ajustar según su entorno
# IMPORTANTE: En backend/.env agregue E2E_ENABLED=true para que /mock-email funcione

# URL donde corre la app:
# - Servidor (backend sirve frontend): http://localhost:5042
# - Local con npm start: http://localhost:3020
E2E_BASE_URL=http://localhost:5042

# Credenciales de usuarios de prueba (deben existir en la BD)
E2E_EMPLOYEE_EMAIL=sistemas.ti@bacarsa.com.ar
E2E_EMPLOYEE_PASSWORD=123456

E2E_BOSS_EMAIL=francosartori.dev@gmail.com
E2E_BOSS_PASSWORD=123456

E2E_PURCHASING_EMAIL=compras@bacarsa.com.ar
E2E_PURCHASING_PASSWORD=123456

E2E_SUPPLIER_EMAIL=francosarto11@gmail.com
E2E_SUPPLIER_PASSWORD=123456
